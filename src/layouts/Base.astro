---
import '../styles/global.css';
import { useI18n, LANGS, LANG_TAGS, DEFAULT_LANG, localizePath, stripLang, isTranslatedPath } from '../i18n';

interface Props {
  title?: string;
  description?: string;
}

const { t, lang, tag } = useI18n(Astro);
const {
  title = t('Mufasa — Private Safaris in Tanzania'),
  description = t('Deeply personal journeys through Tanzania, drawn by hand in Arusha and carried by the guides who walk them.'),
} = Astro.props;

/* Every translated page lists its siblings for search engines. Pages whose
   body is still English-only (articles, legal) canonicalise to the English
   original instead, so the prefixed copies don't compete with it. */
const basePath = stripLang(Astro.url.pathname);
const translated = isTranslatedPath(Astro.url.pathname);
const abs = (p: string) => new URL(p, Astro.site ?? Astro.url).href;
const canonical = abs(translated ? localizePath(basePath, lang) : basePath);
const alternates = translated
  ? LANGS.map((l) => ({ hreflang: LANG_TAGS[l], href: abs(localizePath(basePath, l)) }))
  : [];
---

<!doctype html>
<html lang={tag}>
  <head>
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-DB59F1K5WC"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-DB59F1K5WC');
    </script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" sizes="32x32" href="/brand/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/brand/favicon-192.png" />
    <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    {translated && <link rel="alternate" hreflang="x-default" href={abs(basePath)} />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={lang === DEFAULT_LANG ? 'en_GB' : `${lang}_${lang.toUpperCase()}`} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600&family=Petrona:ital,wght@0,300;0,400;0,500;0,600;1,400&family=Space+Mono:wght@400;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
  </body>
</html>
