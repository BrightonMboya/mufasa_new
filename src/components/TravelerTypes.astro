---
// Homepage segment: reframes the same journeys around who is coming along.
// Simple centered layout — image, plain caption, one shared CTA into the
// trip planner, which already opens with "who is travelling?".
const types = [
  {
    title: 'Family Safaris',
    image: '/media/travelers/family.jpg',
    alt: 'A mother and two children on a walking safari, an elephant grazing in the distance',
  },
  {
    title: 'Honeymoons & Celebrations',
    image: '/media/travelers/honeymoon.jpg',
    alt: 'A silhouetted couple walking at sunset beneath an acacia tree',
  },
  {
    title: 'Friends & Small Groups',
    image: '/media/travelers/friends.jpg',
    alt: 'A group of friends photographing a lion from their safari vehicle at sunset',
  },
  {
    title: 'Solo Journeys',
    image: '/media/travelers/solo.jpg',
    alt: 'A woman sitting alone on the hood of a safari vehicle, looking out over open grassland under a clear sky',
  },
];
---

<section class="trav section wrap">
  <div class="trav__head">
    <h2>Who's coming with you?</h2>
    <p>Every route on this site can be shaped around any of these.</p>
  </div>

  <div class="trav__grid">
    {types.map((t) => (
      <a class="travcard" href="/trip-planner">
        <div class="travcard__frame">
          <img src={t.image} alt={t.alt} loading="lazy" />
        </div>
        <h3 class="travcard__title">{t.title}</h3>
      </a>
    ))}
  </div>

  <div class="trav__foot">
    <a href="/trip-planner" class="pill pill--accent">Tell us who's travelling</a>
  </div>
</section>

<style>
  .trav {
    background-color: var(--color-surface);
    color: var(--color-ink);
    text-align: center;
  }
  .trav__head {
    max-width: 560px;
    margin-inline: auto;
    margin-bottom: clamp(2.5rem, 5vw, 3.75rem);
  }
  .trav__head h2 {
    font-style: italic;
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    font-weight: var(--fw-light);
    color: var(--color-ink);
    line-height: 1.05;
    margin-bottom: 1rem;
  }
  .trav__head p {
    color: var(--color-slate);
    line-height: 1.6;
  }

  .trav__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(1.25rem, 3vw, 2rem);
  }

  .travcard {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.125rem;
  }
  .travcard__frame {
    width: 100%;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--radius-sm);
  }
  .travcard__frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }
  .travcard:hover .travcard__frame img {
    transform: scale(1.04);
  }
  .travcard__title {
    font-size: clamp(1.0625rem, 1.6vw, 1.25rem);
    font-weight: var(--fw-regular);
    color: var(--color-ink);
  }

  .trav__foot {
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }

  @media (max-width: 860px) {
    .trav__grid {
      grid-template-columns: repeat(2, 1fr);
      max-width: 460px;
      margin-inline: auto;
      row-gap: 2.5rem;
    }
  }
</style>
