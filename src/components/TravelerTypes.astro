---
// Homepage segment: reframes the same journeys around who is coming along.
// Simple centered layout — image, plain caption, one shared CTA into the
// trip planner, which already opens with "who is travelling?".
import { useI18n } from '../i18n';

const { t, path } = useI18n(Astro);

const types = [
  {
    title: t('Family Safaris'),
    image: '/media/travelers/family.jpg',
    alt: t('A Maasai guide walking a family through open grassland, zebra grazing behind them'),
  },
  {
    title: t('Honeymoons & Celebrations'),
    image: '/media/travelers/honeymoon.jpg',
    alt: t('A couple embracing beside a sundowner table at sunset, champagne in hand'),
  },
  {
    title: t('Friends & Large Groups'),
    image: '/media/travelers/friends.jpg',
    alt: t('Maasai dancers and a group of laughing guests together on a lantern-lit camp deck'),
  },
  {
    title: t('Solo Journeys'),
    image: '/media/travelers/solo.jpg',
    alt: t('A woman sitting alone above a fire bowl at dusk with a glass of wine, looking out over the bush'),
  },
];
---

<section class="trav section wrap">
  <div class="trav__head">
    <h2>{t("Who's coming with you?")}</h2>
    <p>{t('Every route on this site can be shaped around any of these.')}</p>
  </div>

  <div class="trav__grid">
    {types.map((type) => (
      <a class="travcard" href={path('/trip-planner')}>
        <div class="travcard__frame">
          <img src={type.image} alt={type.alt} loading="lazy" decoding="async" />
        </div>
        <h3 class="travcard__title">{type.title}</h3>
      </a>
    ))}
  </div>

  <div class="trav__foot">
    <a href={path('/trip-planner')} class="pill pill--accent">{t("Tell us who's travelling")}</a>
  </div>
</section>

<style>
  .trav {
    background-color: var(--color-surface);
    color: var(--color-ink);
    text-align: center;
  }
  .trav__head {
    max-width: 560px;
    margin-inline: auto;
    margin-bottom: clamp(2.5rem, 5vw, 3.75rem);
  }
  .trav__head h2 {
    font-style: italic;
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    font-weight: var(--fw-light);
    color: var(--color-ink);
    line-height: 1.05;
    margin-bottom: 1rem;
  }
  .trav__head p {
    color: var(--color-slate);
    line-height: 1.6;
  }

  .trav__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(1.25rem, 3vw, 2rem);
  }

  .travcard {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.125rem;
  }
  .travcard__frame {
    width: 100%;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--radius-sm);
  }
  .travcard__frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }
  .travcard:hover .travcard__frame img {
    transform: scale(1.04);
  }
  .travcard__title {
    font-size: clamp(1.0625rem, 1.6vw, 1.25rem);
    font-weight: var(--fw-regular);
    color: var(--color-ink);
  }

  .trav__foot {
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }

  @media (max-width: 860px) {
    .trav__grid {
      grid-template-columns: repeat(2, 1fr);
      max-width: 460px;
      margin-inline: auto;
      row-gap: 2.5rem;
    }
  }
</style>
