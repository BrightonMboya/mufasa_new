---
import type { journeys } from '../data/site';
import { cardPhotos, introductions } from '../data/journey-cards';

interface Props {
  journey: (typeof journeys)[number];
  showPrice?: boolean;
  /* What the tab filter matches this card against. Defaults to the journey's
     own category; the homepage groups by how you reach the route instead. */
  filterGroup?: string;
}
const { journey: j, showPrice = false, filterGroup } = Astro.props;
---

<a
        class:list={['jcard', { 'jcard--catalog': showPrice }]}
        href={`/journeys/${j.slug}`}
        data-category={filterGroup ?? j.category}
        data-search={`${j.title} ${j.category} ${j.summary} ${j.days.map((d) => d.place).join(' ')}`.toLowerCase()}
      >
        <div class="jcard__frame">
          <img src={cardPhotos[j.slug]?.src ?? j.image} style={{ objectPosition: cardPhotos[j.slug]?.position ?? 'center' }} alt="" loading="lazy" />
          <span class:list={['jcard__duration', { 'jcard__duration--left': !!cardPhotos[j.slug] }]}>{j.nights} {j.nights === 1 ? 'night' : 'nights'}</span>
          <h3 class="jcard__title">{j.title}</h3>
        </div>
        <div class="jcard__body">
          <p class="jcard__intro">{introductions[j.slug] ?? j.summary}</p>
          {showPrice && (
            <p class="jcard__price">
              {j.priceFrom.startsWith('$') ? <><span>From </span><strong>{j.priceFrom}</strong><span> / person</span></> : <strong>{j.priceFrom}</strong>}
            </p>
          )}
          <div class="jcard__footer">
            <div class="jcard__season">
              <span>Best time to go</span>
              <strong>{j.season}</strong>
            </div>
            <span class="jcard__cta">
              View itinerary
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="m9 5 7 7-7 7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
          </div>
        </div>
      </a>

<style>
  .jcard {
    display: flex;
    min-width: 0;
    flex-direction: column;
    background: #fffcf7;
    border-radius: 5px;
    overflow: hidden;
    text-align: left;
    box-shadow: 0 2px 6px rgb(20 24 21 / 4%);
  }
  .jcard:focus-visible {
    outline: 3px solid var(--color-accent);
    outline-offset: 5px;
  }
  .jcard__frame {
    position: relative;
    isolation: isolate;
    width: 100%;
    aspect-ratio: 1.12;
    overflow: hidden;
    background: var(--color-ink-panel);
  }
  .jcard__frame::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(180deg, transparent 30%, rgb(10 20 14 / 25%) 55%, rgb(10 20 14 / 85%) 100%);
  }
  .jcard__frame img {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }
  .jcard:is(:hover, :focus-visible) .jcard__frame img {
    transform: scale(1.035);
  }
  .jcard__duration {
    position: absolute;
    top: 1.125rem;
    right: 1.125rem;
    padding: 0.35rem 0.8rem;
    border-radius: var(--radius-full);
    background: var(--color-surface);
    color: var(--color-ink);
    font-size: 0.8125rem;
    font-weight: var(--fw-medium);
  }
  .jcard__duration--left {
    right: auto;
    left: 1.125rem;
  }
  .jcard__title {
    position: absolute;
    inset: auto 1.5rem 1.5rem;
    color: #fff;
    font-size: clamp(1.75rem, 2.65vw, 2.625rem);
    line-height: 1.1;
    text-wrap: balance;
  }
  .jcard__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 1.5rem;
  }
  .jcard__intro {
    margin-bottom: 1.5rem;
    color: #535d55;
    font-size: 0.9375rem;
    line-height: 1.65;
  }
  .jcard__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: auto;
    padding-top: 1.125rem;
  }
  .jcard__season {
    display: grid;
    gap: 0.2rem;
    font-size: 0.8125rem;
  }
  .jcard__season > span {
    color: #626b63;
    font-size: 0.75rem;
  }
  .jcard__season strong {
    font-weight: var(--fw-medium);
  }
  .jcard__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-accent);
    font-size: 0.8125rem;
    font-weight: var(--fw-semibold);
  }
  .jcard__cta svg {
    width: 1.75rem;
    height: 1.75rem;
    padding: 0.35rem;
    border: 1px solid var(--color-hairline);
    border-radius: 50%;
    transition: background-color 0.2s ease, color 0.2s ease;
  }
  .jcard:is(:hover, :focus-visible) .jcard__cta svg {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: #fff;
  }
  .jcard[hidden] {
    display: none;
  }

  .jcard--catalog .jcard__title {
    font-size: clamp(1.625rem, 2.2vw, 2.125rem);
  }
  .jcard__price {
    margin-top: auto;
    margin-bottom: 1.125rem;
    color: #535d55;
    font-size: 0.8125rem;
  }
  .jcard__price strong {
    color: var(--color-ink);
    font-size: 1.25rem;
    font-weight: var(--fw-medium);
  }
  .jcard--catalog .jcard__footer { margin-top: 0; }
</style>
