---
import { statement } from '../data/site';
---

<section class="statement section wrap">
  <div class="statement__inner">
    <p class="statement__lead">{statement.lead}</p>
    <p class="statement__body">{statement.body}</p>
  </div>
</section>

<style>
  .statement {
    background-color: var(--color-ground);
  }
  .statement__inner {
    max-width: 1000px;
    display: flex;
    flex-direction: column;
    gap: 2.125rem;
  }
  .statement__lead {
    font-family: var(--font-display);
    font-weight: var(--fw-light);
    font-size: clamp(1.75rem, 4vw, 2.875rem);
    line-height: 1.28;
    letter-spacing: -0.02em;
    color: var(--color-ink);
  }
  .statement__body {
    max-width: var(--container-text);
    color: var(--color-slate);
    line-height: 1.65;
  }
</style>
