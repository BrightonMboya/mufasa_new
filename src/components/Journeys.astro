---
import JourneyCard from './JourneyCard.astro';
import { journeys as allJourneys } from '../data/site';

/* The homepage showcases real, bookable itineraries — three driven from
   Arusha, three flown in from Zanzibar. "North to Sea" is deliberately not
   here: it is the collection these northern routes belong to, not a route you
   can book, and it reads as a duplicate beside its own contents. The full
   library, that hub included, is behind "See all Itineraries".

   Curated rather than sliced off the array so the durations ladder (5/6/7 days
   overland, 2/3/4 days fly-in) instead of landing wherever the data order does. */
const NORTHERN_CIRCUIT = [
  '5-days-manyara-serengeti-ngorongoro-best-luxury-safari',
  '6-day-the-great-wildebeest-migration-safari',
  '7-day-private-luxury-safari-to-tanzania-premier-parks',
];
const FROM_ZANZIBAR = [
  '2-day-tarangire-and-ngorongoro-crater-from-zanzibar',
  '3-day-luxury-fly-in-fly-out-safari-from-zanzibar',
  '4-day-endless-plains-from-zanzibar-to-serengeti',
];

const NORTHERN = 'Northern Circuit';
const ZANZIBAR = 'Fly-In from Zanzibar';

const bySlug = (slug: string) => allJourneys.find((j) => j.slug === slug);
// Every slug above must resolve, or a card silently vanishes from the homepage.
const pick = (slugs: string[], group: string) =>
  slugs.map((slug) => {
    const journey = bySlug(slug);
    if (!journey) throw new Error(`Journeys: unknown slug "${slug}"`);
    return { journey, group };
  });

const cards = [...pick(NORTHERN_CIRCUIT, NORTHERN), ...pick(FROM_ZANZIBAR, ZANZIBAR)];

// Both rows are category "Northern Circuit", so tabbing on category would give
// one dead filter. Tab on how you get there, which is the real difference.
const filters = ['All', NORTHERN, ZANZIBAR];
---

<section id="journeys" class="journeys section wrap">
  <div class="journeys__head">
    <h2>Our Journeys</h2>
    <div class="journeys__head-actions">
      <a href="#enquiry" class="pill pill--accent">Make an Enquiry</a>
    </div>
  </div>

  <div class="journeys__tabs" role="tablist" aria-label="Journey categories">
    {filters.map((f, i) => (
      <button
        class:list={['tab', { 'tab--active': i === 0 }]}
        role="tab"
        aria-selected={i === 0}
        data-filter={f}
      >
        {f}
      </button>
    ))}
  </div>

  <div class="journeys__grid" data-journeys-grid>
    {cards.map(({ journey, group }) => <JourneyCard journey={journey} filterGroup={group} />)}
  </div>

  <p class="journeys__empty" data-journeys-empty hidden>
    No journeys match that yet — <a href="#enquiry">tell us what you have in mind</a> and we’ll draw one.
  </p>

  <div class="journeys__all">
    <a href="/journeys" class="pill pill--accent">See all Itineraries</a>
  </div>
</section>

<style>
  .journeys {
    background-color: var(--color-surface);
  }
  .journeys__all {
    display: flex;
    justify-content: center;
    margin-top: clamp(2rem, 4vw, 3rem);
  }
  .journeys__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
    margin-bottom: 2.5rem;
  }
  .journeys__head-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .journeys__head h2 {
    font-style: italic;
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: var(--fw-light);
    color: var(--color-ink);
  }

  .journeys__tabs {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(1rem, 2.5vw, 2.375rem);
    padding-bottom: 2rem;
  }
  .tab {
    font-size: var(--text-label);
    font-weight: var(--fw-medium);
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--color-slate);
    padding-bottom: 0.5rem;
    border-bottom: 2px solid transparent;
    transition: color 0.2s ease, border-color 0.2s ease;
  }
  .tab:hover {
    color: var(--color-ink);
  }
  .tab--active {
    color: var(--color-ink);
    font-weight: var(--fw-semibold);
    border-bottom-color: var(--color-accent);
  }

  .journeys__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }
  .tab:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 5px;
  }

  .journeys__empty {
    margin-top: 3rem;
    text-align: center;
    color: var(--color-slate);
  }
  .journeys__empty a {
    color: var(--color-accent);
    border-bottom: 1px solid currentColor;
  }

  @media (min-width: 641px) and (max-width: 1050px) {
    .journeys__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 640px) {
    .journeys__grid {
      grid-template-columns: 1fr;
      max-width: 460px;
      margin-inline: auto;
      gap: 1.75rem;
    }
  }
</style>

<script>
  const grid = document.querySelector('[data-journeys-grid]');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('.jcard'));
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.tab'));
  const empty = document.querySelector<HTMLElement>('[data-journeys-empty]');

  // Apply a filter: either by category (from a tab) or a free-text query
  // (from the hero search). `query` wins when present.
  function apply({ category = 'All', query = '' } = {}) {
    const q = query.trim().toLowerCase();
    let shown = 0;
    cards.forEach((card) => {
      const matchCat = category === 'All' || card.dataset.category === category;
      const matchQuery = !q || (card.dataset.search ?? '').includes(q);
      const visible = matchCat && matchQuery;
      card.hidden = !visible;
      if (visible) shown++;
    });
    if (empty) empty.hidden = shown !== 0;
  }

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      tabs.forEach((t) => {
        t.classList.toggle('tab--active', t === tab);
        t.setAttribute('aria-selected', String(t === tab));
      });
      apply({ category: tab.dataset.filter ?? 'All' });
    });
  });

  // The hero search dispatches this; reset tabs to "All" and filter by text.
  window.addEventListener('mufasa:search', (e) => {
    const query = (e as CustomEvent<{ query: string }>).detail?.query ?? '';
    tabs.forEach((t, i) => {
      t.classList.toggle('tab--active', i === 0);
      t.setAttribute('aria-selected', String(i === 0));
    });
    apply({ query });
    grid?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });
</script>
