---
import { enquiry, site } from '../data/site';
---

<!-- A plain band, no photo: the footer below is a full-bleed scene, and two
     photo sections back to back fight each other. -->
<section id="enquiry" class="enquiry section">
  <div class="enquiry__content wrap">
    <h2>{enquiry.title}</h2>
    <p>{enquiry.body}</p>
    <div class="enquiry__cta">
      <a href="/trip-planner" class="pill pill--accent">Start the conversation</a>
      <a href={`mailto:${site.email}`} class="pill pill--outline">Email us</a>
    </div>
  </div>
</section>

<style>
  .enquiry { background-color: #f8f4ee; }
  .enquiry__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.75rem;
    max-width: 760px;
    margin-inline: auto;
    padding-block: clamp(1rem, 3vw, 2.5rem);
    text-align: center;
  }
  .enquiry__content h2 {
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    font-weight: var(--fw-light);
    color: var(--color-ink);
    line-height: 1.1;
  }
  .enquiry__content p {
    max-width: 540px;
    color: var(--color-slate);
  }
  .enquiry__cta {
    display: flex;
    justify-content: center;
    gap: 0.875rem;
    flex-wrap: wrap;
    margin-top: 0.5rem;
  }
</style>
