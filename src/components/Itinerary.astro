---
import RouteMap from './RouteMap.astro';
import { journeys } from '../data/site';

// Homepage teaser uses the flagship "North to Sea" route.
const featured = journeys.find((j) => j.slug === 'north-to-sea') ?? journeys[0];
const stops = featured.days.map((d) => ({ days: d.days, place: d.place, note: d.note, optional: d.optional }));
---

<section class="itin section wrap">
  <div class="itin__head">
    <h2>Fourteen nights, north to sea</h2>
    <div class="itin__legend">
      <span class="legend"><span class="legend__line legend__line--solid"></span>Core route</span>
      <span class="legend"><span class="legend__line legend__line--dashed"></span>Extension</span>
    </div>
  </div>

  <RouteMap stops={stops} />

  <div class="itin__foot">
    <a href={`/journeys/${featured.slug}`} class="pill pill--ghost">See the full itinerary</a>
  </div>
</section>

<style>
  .itin {
    background-color: var(--color-ink);
    color: var(--color-on-accent);
  }
  .itin__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2.5rem;
    flex-wrap: wrap;
    margin-bottom: clamp(3rem, 7vw, 5.625rem);
  }
  .itin__head h2 {
    max-width: 20ch;
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    font-weight: var(--fw-light);
    color: var(--color-on-accent);
  }
  .itin__legend {
    display: flex;
    gap: 1.875rem;
  }
  .legend {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(247, 244, 238, 0.75);
    white-space: nowrap;
  }
  .legend__line {
    width: 26px;
    height: 2px;
    flex-shrink: 0;
  }
  .legend__line--solid {
    background-color: var(--color-accent-soft);
  }
  .legend__line--dashed {
    border-top: 2px dashed rgba(247, 244, 238, 0.45);
  }

  .itin__foot {
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }
</style>
