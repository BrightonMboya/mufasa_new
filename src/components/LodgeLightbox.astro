---
---

<div class="llb" data-llb hidden>
  <div class="llb__backdrop" data-llb-close></div>
  <div class="llb__stage" role="dialog" aria-modal="true" aria-label="Accommodation photos">
    <button type="button" class="llb__close" data-llb-close aria-label="Close">&times;</button>
    <button type="button" class="llb__nav llb__nav--prev" data-llb-prev aria-label="Previous photo">&#8249;</button>
    <img class="llb__img" data-llb-img src="" alt="" />
    <button type="button" class="llb__nav llb__nav--next" data-llb-next aria-label="Next photo">&#8250;</button>
    <span class="llb__count" data-llb-count></span>
  </div>
</div>

<script>
  const root = document.querySelector('[data-llb]');
  if (root) {
    const img = root.querySelector('[data-llb-img]');
    const countEl = root.querySelector('[data-llb-count]');
    let gallery = [];
    let index = 0;

    function render() {
      img.src = gallery[index];
      countEl.textContent = `${index + 1} / ${gallery.length}`;
    }
    function open(urls, startAt) {
      gallery = urls;
      index = startAt;
      render();
      root.hidden = false;
      document.body.style.overflow = 'hidden';
    }
    function close() {
      root.hidden = true;
      document.body.style.overflow = '';
    }
    function step(dir) {
      index = (index + dir + gallery.length) % gallery.length;
      render();
    }

    document.querySelectorAll('[data-lodge-gallery]').forEach((trigger) => {
      trigger.addEventListener('click', () => {
        try {
          const urls = JSON.parse(trigger.getAttribute('data-lodge-gallery') || '[]');
          if (urls.length) open(urls, 0);
        } catch {
          /* malformed gallery data — ignore */
        }
      });
    });

    root.querySelectorAll('[data-llb-close]').forEach((el) => el.addEventListener('click', close));
    root.querySelector('[data-llb-prev]')?.addEventListener('click', () => step(-1));
    root.querySelector('[data-llb-next]')?.addEventListener('click', () => step(1));
    document.addEventListener('keydown', (e) => {
      if (root.hidden) return;
      if (e.key === 'Escape') close();
      if (e.key === 'ArrowLeft') step(-1);
      if (e.key === 'ArrowRight') step(1);
    });
  }
</script>

<style>
  .llb {
    position: fixed;
    inset: 0;
    z-index: 60;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .llb[hidden] { display: none; }
  .llb__backdrop {
    position: absolute;
    inset: 0;
    background-color: rgba(20, 24, 21, 0.92);
  }
  .llb__stage {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(1.5rem, 5vw, 4rem);
  }
  .llb__img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }
  .llb__close {
    position: absolute;
    top: 1.25rem;
    right: 1.5rem;
    z-index: 1;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.75rem;
    line-height: 1;
    color: var(--color-on-accent);
  }
  .llb__close:hover { color: var(--color-accent-soft); }
  .llb__nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 52px;
    height: 52px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2rem;
    line-height: 1;
    color: var(--color-on-accent);
    background-color: rgba(247, 244, 238, 0.08);
    border-radius: var(--radius-full);
    transition: background-color 0.2s ease;
  }
  .llb__nav:hover { background-color: rgba(247, 244, 238, 0.18); }
  .llb__nav--prev { left: clamp(0.75rem, 3vw, 2.5rem); }
  .llb__nav--next { right: clamp(0.75rem, 3vw, 2.5rem); }
  .llb__count {
    position: absolute;
    bottom: 1.5rem;
    left: 50%;
    transform: translateX(-50%);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    color: rgba(247, 244, 238, 0.7);
  }

  @media (max-width: 640px) {
    .llb__nav { width: 42px; height: 42px; font-size: 1.5rem; }
  }
</style>
