---
import { beyondTanzania, journeys, journeyCountry } from '../data/site';

/* The lowest price comes from the journeys themselves, so a new Kenya or
   Rwanda itinerary updates its card without touching this file. */
const priceOf = (p: string) => Number(p.replace(/[^\d]/g, ''));
const cards = beyondTanzania.countries.map((c) => {
  const trips = journeys.filter((j) => journeyCountry(j) === c.name);
  const from = trips.length ? Math.min(...trips.map((j) => priceOf(j.priceFrom))) : 0;
  return { ...c, from };
});
---

<section id="beyond" class="beyond section wrap">
  <div class="beyond__head">
    <h2>{beyondTanzania.title}</h2>
    <p>{beyondTanzania.body}</p>
  </div>

  <div class="beyond__grid">
    {cards.map((c) => (
      <a class="bcard" href={c.href}>
        <div class="bcard__media">
          <img src={c.image} alt="" loading="lazy" decoding="async" />
        </div>
        <div class="bcard__body">
          <h3 class="bcard__name">{c.name}</h3>
          <p class="bcard__line">{c.line}</p>
          <div class="bcard__foot">
            {c.from > 0 && (
              <span class="bcard__price">From <strong>${c.from.toLocaleString('en-US')}</strong> / person</span>
            )}
            <span class="bcard__cta">
              View {c.name} journeys
              <svg width="16" height="11" viewBox="0 0 14 10" fill="none" aria-hidden="true"><path d="M1 5h12M9 1l4 4-4 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
          </div>
        </div>
      </a>
    ))}
  </div>
</section>

<style>
  .beyond {
    background-color: var(--color-surface);
  }
  .beyond__head {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 640px;
    margin-bottom: clamp(2.5rem, 5vw, 3.75rem);
  }
  .beyond__head h2 {
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    font-weight: var(--fw-light);
    color: var(--color-ink);
    line-height: 1.05;
  }
  .beyond__head p {
    color: var(--color-slate);
    line-height: 1.65;
    max-width: 500px;
  }

  .beyond__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }

  /* Tall photo cards, the country name set large over a deep scrim — a
     destination, not a product tile. */
  .bcard {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: clamp(420px, 44vw, 600px);
    overflow: hidden;
    border-radius: var(--radius-sm);
    color: var(--color-on-accent);
  }
  .bcard__media {
    position: absolute;
    inset: 0;
    z-index: -2;
    background: var(--color-ink-panel);
  }
  .bcard__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.9s cubic-bezier(0.2, 0.6, 0.2, 1);
  }
  .bcard::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      to top,
      rgba(12, 16, 13, 0.88) 0%,
      rgba(12, 16, 13, 0.55) 34%,
      rgba(12, 16, 13, 0.1) 62%,
      rgba(12, 16, 13, 0.25) 100%
    );
  }
  .bcard:hover .bcard__media img {
    transform: scale(1.04);
  }
  .bcard:focus-visible {
    outline: 3px solid var(--color-accent);
    outline-offset: 5px;
  }

  .bcard__body {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: clamp(1.5rem, 2.8vw, 2.5rem);
  }
  .bcard__name {
    font-size: clamp(3rem, 6.5vw, 5.5rem);
    font-weight: var(--fw-light);
    line-height: 0.95;
  }
  .bcard__line {
    font-size: 1.0625rem;
    line-height: 1.5;
    color: rgba(247, 244, 238, 0.88);
    max-width: 26rem;
  }
  .bcard__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    margin-top: 0.75rem;
  }
  .bcard__price {
    font-size: 0.875rem;
    color: rgba(247, 244, 238, 0.8);
  }
  .bcard__price strong {
    font-weight: var(--fw-semibold);
    color: var(--color-on-accent);
  }
  .bcard__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-accent-soft);
  }
  .bcard__cta svg {
    transition: transform 0.25s ease;
  }
  .bcard:hover .bcard__cta svg {
    transform: translateX(4px);
  }

  @media (max-width: 760px) {
    .beyond__grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
    .bcard {
      min-height: clamp(400px, 105vw, 520px);
    }
  }
</style>
