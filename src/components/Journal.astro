---
import { getCollection } from 'astro:content';

// The three most recent pieces. Posts live in the `blog` collection, which
// /blog and the article pages read from too.
const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<section id="journal" class="journal section wrap">
  <div class="journal__intro">
    <p class="eyebrow">Field Notes</p>
    <h2>From the Journal</h2>
    <p class="journal__lead">
      Safari planning, Kilimanjaro prep, and the small details that make a trip — written by the guides and planners behind them.
    </p>
  </div>

  <div class="journal__grid">
    {posts.map((post, i) => (
      <a class="pcard" href={`/blog/${post.id}`}>
        <div class="pcard__frame">
          <img src={post.data.image} alt={post.data.title} loading="lazy" decoding="async" />
        </div>
        <span class="pcard__meta">
          {post.data.category} · {post.data.date.toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}
        </span>
        <h3 class="pcard__title">{post.data.title}</h3>
        <p class="pcard__desc">{post.data.description}</p>
        <span class="pcard__cta">Read the story <span aria-hidden="true">&rarr;</span></span>
      </a>
    ))}
  </div>

  <a href="/blog" class="pill pill--outline journal__all">Read the Journal</a>
</section>

<style>
  .journal {
    background-color: var(--color-surface);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(2.5rem, 5vw, 3.5rem);
  }
  .journal__intro {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.875rem;
    text-align: center;
    max-width: 640px;
  }
  .journal__intro h2 {
    font-style: italic;
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: var(--fw-light);
    color: var(--color-ink);
  }
  .journal__lead {
    color: var(--color-slate);
    line-height: 1.7;
    font-size: 1.0625rem;
  }

  .journal__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.5rem, 3vw, 2.5rem);
    width: 100%;
  }
  .pcard {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .pcard__frame {
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    margin-bottom: 0.75rem;
  }
  .pcard__frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }
  .pcard:hover .pcard__frame img { transform: scale(1.04); }
  .pcard__meta {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-slate);
  }
  /* Reserve two lines so the CTA lands on one lane across the row. */
  .pcard__title {
    font-size: clamp(1.25rem, 2.2vw, 1.5rem);
    color: var(--color-ink);
    line-height: 1.25;
    min-height: 2.5em;
    transition: color 0.25s ease;
  }
  .pcard:hover .pcard__title { color: var(--color-accent); }
  .pcard__desc {
    color: var(--color-slate);
    font-size: 0.9375rem;
    line-height: 1.6;
  }
  .pcard__cta {
    margin-top: auto;
    padding-top: 0.75rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent);
  }
  .pcard__cta span { transition: transform 0.25s ease; }
  .pcard:hover .pcard__cta span { transform: translateX(4px); }

  @media (max-width: 860px) {
    .journal__grid {
      grid-template-columns: 1fr;
      max-width: 460px;
      margin-inline: auto;
      gap: 2.5rem;
    }
    .pcard__title { min-height: 0; }
  }
</style>
