---
import { hero } from '../data/site';


---

<section class="hero">
  <div class="hero__slides" aria-hidden="true">
    {/* The first frame is the video's poster and the fallback's first slide.
        The rest only get fetched if the video never comes up. */}
    {hero.images.map((src, i) => (
      <img
        class="hero__slide"
        class:list={[{ 'is-active': i === 0 }]}
        src={i === 0 ? src : undefined}
        data-src={i === 0 ? undefined : src}
        alt=""
        loading={i === 0 ? 'eager' : 'lazy'}
        fetchpriority={i === 0 ? 'high' : 'auto'}
        data-hero-slide
      />
    ))}
  </div>

  <div class="hero__video-frame" aria-hidden="true">
    <video
      class="hero__video"
      data-src={hero.video.src}
      data-src-small={hero.video.srcSmall}
      poster={hero.video.poster}
      muted
      loop
      playsinline
      preload="none"
      data-hero-video
    ></video>
  </div>

  <div class="hero__scrim"></div>

  <div class="hero__headline wrap">
    <h1>{hero.title}</h1>
    <p>{hero.subtitle}</p>
    <a href={hero.cta.href} class="hero__cta">
      {hero.cta.label}
      <svg width="16" height="12" viewBox="0 0 16 12" fill="none" aria-hidden="true">
        <path d="M1 6h13m0 0-4.5-4.5M14 6l-4.5 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </a>
  </div>
</section>

<style>
  .hero {
    --hero-h: clamp(560px, 88vh, 860px);
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    min-height: var(--hero-h);
    overflow: hidden;
    background-color: var(--color-ink);
    isolation: isolate;
  }

  .hero__slides {
    position: absolute;
    inset: 0;
    z-index: -3;
  }

  /* Video sits above the stills, but stays invisible until the player says it
     is ready — a refused embed leaves the image hero untouched. */
  .hero__video-frame {
    position: absolute;
    inset: 0;
    z-index: -2;
    overflow: hidden;
    opacity: 0;
    transition: opacity 1s ease;
    pointer-events: none;
  }
  .hero__video-frame.is-ready {
    opacity: 1;
  }
  .hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border: 0;
  }
  .hero__slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 1.8s ease;
  }
  .hero__slide.is-active {
    opacity: 1;
  }
  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    /* Headline now sits low in the frame, so the darkening follows it:
       a soft ellipse under the copy, over a vertical gradient that keeps
       the top nav legible and weights the bottom third. */
    background:
      radial-gradient(
        ellipse 80% 45% at 50% 88%,
        rgba(20, 24, 21, 0.5) 0%,
        rgba(20, 24, 21, 0) 75%
      ),
      linear-gradient(
        180deg,
        rgba(20, 24, 21, 0.42) 0%,
        rgba(20, 24, 21, 0.12) 32%,
        rgba(20, 24, 21, 0.38) 72%,
        rgba(20, 24, 21, 0.72) 100%
      ),
      rgba(20, 24, 21, 0.06);
  }

  .hero__headline {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.125rem;
    text-align: center;
    padding-bottom: clamp(3rem, 8vh, 5.5rem);
  }
  .hero__headline h1 {
    max-width: 20ch;
    font-size: clamp(1.5rem, 2.8vw, 2.75rem);
    line-height: 1.15;
    text-wrap: balance;
    font-weight: var(--fw-regular);
    text-transform: uppercase;
    letter-spacing: -0.005em;
    color: var(--color-on-accent);
    text-shadow: 0 2px 24px rgba(20, 24, 21, 0.35);
  }
  .hero__headline p {
    max-width: 60ch;
    font-size: clamp(0.9375rem, 1.3vw, 1.0625rem);
    line-height: 1.55;
    color: rgba(247, 244, 238, 0.92);
    text-shadow: 0 1px 16px rgba(20, 24, 21, 0.4);
  }

  .hero__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 0.875rem;
    padding: 1.0625rem 2.25rem;
    border-radius: var(--radius-full);
    background-color: var(--color-accent);
    color: var(--color-on-accent);
    font-family: var(--font-ui);
    font-size: 0.875rem;
    font-weight: var(--fw-semibold);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    transition: background-color 0.25s ease, transform 0.25s ease;
  }
  .hero__cta:hover {
    background-color: var(--color-accent-deep);
  }
  .hero__cta svg {
    transition: transform 0.25s ease;
  }
  .hero__cta:hover svg {
    transform: translateX(3px);
  }

  @media (max-width: 760px) {
    .hero {
      /* Full-screen on phones. svh is the viewport with the browser chrome
         showing, so the CTA never lands under the address bar; vh is the
         fallback for browsers without it. */
      --hero-h: 100vh;
      --hero-h: 100svh;
    }
  }
</style>

<script>
  const slides = document.querySelectorAll<HTMLImageElement>('[data-hero-slide]');
  const frame = document.querySelector<HTMLElement>('.hero__video-frame');
  const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Fall back to the image slideshow: pull in the slides we deferred, then
  // crossfade every 6s. Holds on the first frame under reduced-motion.
  let started = false;
  function useSlideshow() {
    if (started) return;
    started = true;
    slides.forEach((s) => {
      const src = s.dataset.src;
      if (src && !s.src) s.src = src;
    });
    if (slides.length < 2 || reduced) return;
    let index = 0;
    setInterval(() => {
      slides[index].classList.remove('is-active');
      index = (index + 1) % slides.length;
      slides[index].classList.add('is-active');
    }, 6000);
  }

  // Who should never be sent the 4.4MB loop. Hosting cannot help a bad
  // connection; not shipping the file to it can. Screen size is deliberately
  // not a factor — phones on a good connection get the video like anyone
  // else. These visitors get the poster plus the image slideshow instead.
  const conn = (navigator as any).connection;
  const saveData = conn?.saveData === true;
  const slowLink = /^(slow-2g|2g|3g)$/.test(conn?.effectiveType ?? '');

  if (!video || !frame || reduced || saveData || slowLink) {
    video?.remove();
    useSlideshow();
  } else {
    let done = false;
    function fallback() {
      if (done) return;
      done = true;
      video!.remove();
      useSlideshow();
    }

    // Only reveal the video once it is genuinely painting frames — a failed
    // fetch or a refused autoplay leaves the image hero in place instead of
    // flashing an empty box.
    video.addEventListener('playing', () => {
      if (done) return;
      done = true;
      frame!.classList.add('is-ready');
    }, { once: true });
    video.addEventListener('error', fallback, { once: true });

    // 480p is indistinguishable on a phone-sized box and costs a third as
    // much data, so narrow viewports get it. Assigning src here — rather
    // than in the markup — is what keeps the unused encode unfetched.
    const small = window.matchMedia('(max-width: 900px)').matches;
    video.src = (small && video.dataset.srcSmall) || video.dataset.src!;
    video.play().catch(fallback);
  }
</script>
