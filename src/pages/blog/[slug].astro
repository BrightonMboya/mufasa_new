---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Enquiry from '../../components/Enquiry.astro';
import JourneyCard from '../../components/JourneyCard.astro';
import { site, journeys } from '../../data/site';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const title = `${post.data.title} — ${site.shortName}`;

/* Readers finish a post wanting to go; hand them three bookable routes.
   Curated so the set spans the migration, a classic circuit and a short
   fly-in from Zanzibar rather than three near-identical northern loops. */
const FEATURED_SLUGS = [
  '6-day-the-great-wildebeest-migration-safari',
  '7-day-private-luxury-safari-to-tanzania-premier-parks',
  '3-day-luxury-fly-in-fly-out-safari-from-zanzibar',
];
const featured = FEATURED_SLUGS.map((slug) => {
  const journey = journeys.find((j) => j.slug === slug);
  // Fail the build rather than ship a post with a silently missing card.
  if (!journey) throw new Error(`Blog featured itineraries: unknown slug "${slug}"`);
  return journey;
});
---

<Base title={title} description={post.data.description}>
  <Header />
  <main>
    <!-- Detail hero -->
    <section class="phero">
      <img class="phero__img" src={post.data.image} alt={post.data.title} fetchpriority="high" decoding="async" />
      <div class="phero__scrim"></div>
      <div class="phero__content wrap">
        <span class="phero__cat">{post.data.category} · {post.data.date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</span>
        <h1>{post.data.title}</h1>
      </div>
    </section>

    <!-- Article body -->
    <section class="article section wrap">
      <div class="prose">
        <Content />
      </div>
      <aside class="article__aside">
        <div class="asidebox">
          <h2>Plan this yourself</h2>
          <p>Speak to the person who designs the route, not a call centre. A first conversation costs nothing.</p>
          <a href="/#enquiry" class="pill pill--accent">Make an enquiry</a>
        </div>
      </aside>
    </section>

    <!-- Featured itineraries -->
    <section class="featured section wrap">
      <div class="featured__head">
        <h2>Featured Itineraries</h2>
        <a href="/journeys" class="pill pill--accent">See all Itineraries</a>
      </div>
      <div class="featured__grid">
        {featured.map((j) => <JourneyCard journey={j} />)}
      </div>
    </section>

    <Enquiry />
  </main>
  <Footer />
</Base>

<style>
  .phero {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: clamp(380px, 52vh, 480px);
    overflow: hidden;
    background-color: var(--color-ink);
    isolation: isolate;
  }
  .phero__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
  }
  .phero__scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(180deg, rgba(20, 24, 21, 0.4) 0%, rgba(20, 24, 21, 0.25) 45%, rgba(20, 24, 21, 0.85) 100%);
  }
  .phero__content {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-block: clamp(2.5rem, 5vw, 3.75rem);
    max-width: 1120px;
  }
  .phero__cat {
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(247, 244, 238, 0.85);
  }
  .phero h1 {
    font-size: clamp(2rem, 4vw, 3.25rem);
    color: var(--color-on-accent);
    font-weight: var(--fw-light);
    line-height: 1.12;
    text-wrap: balance;
  }

  /* Article */
  .article {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: start;
    background-color: var(--color-ground);
  }
  .article > .prose { max-width: 900px; }
  .article__aside { position: sticky; top: 2rem; }
  .asidebox {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: 2rem;
    background-color: var(--color-surface);
    border: 1px solid var(--color-hairline);
  }
  .asidebox h2 {
    font-size: 1.375rem;
    font-weight: var(--fw-light);
    color: var(--color-ink);
  }
  .asidebox p {
    color: var(--color-slate);
    line-height: 1.6;
    font-size: 0.9375rem;
  }

  /* Featured itineraries */
  .featured {
    background-color: var(--color-surface);
  }
  .featured__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
    margin-bottom: 2.5rem;
  }
  .featured__head h2 {
    font-style: italic;
    font-size: clamp(2rem, 4.5vw, 3.25rem);
    font-weight: var(--fw-light);
    color: var(--color-ink);
  }
  .featured__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }
  @media (min-width: 641px) and (max-width: 1050px) {
    .featured__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 640px) {
    .featured__grid {
      grid-template-columns: 1fr;
      max-width: 460px;
      margin-inline: auto;
      gap: 1.75rem;
    }
  }

  @media (max-width: 860px) {
    .article { grid-template-columns: 1fr; }
    .article__aside { position: static; }
  }
</style>
