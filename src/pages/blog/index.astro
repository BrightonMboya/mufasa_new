---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Enquiry from '../../components/Enquiry.astro';
import { site } from '../../data/site';
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const title = `Journal — ${site.shortName}`;
const description = 'Field notes on Tanzania safaris, Kilimanjaro, and the wild south — written by the people who plan the journeys.';
const filters = ['All', ...Array.from(new Set(allPosts.map((p) => p.data.category)))];
---

<Base title={title} description={description}>
  <Header />
  <main>
    <!-- Hero -->
    <section class="jhero">
      <div class="jhero__content wrap">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/">Home</a><span>/</span><span class="crumbs__here">Journal</span>
        </nav>
        <span class="eyebrow" style="color: var(--color-accent-soft)">Journal</span>
        <h1>Field notes from Tanzania</h1>
        <p class="jhero__lead">Safari planning, Kilimanjaro prep, and the small details that make a trip — written by the guides and planners behind them.</p>
      </div>
    </section>

    <!-- Posts -->
    <section class="jposts section wrap">
      <div class="jposts__tabs" role="tablist" aria-label="Journal categories">
        {filters.map((f, i) => (
          <button
            class:list={['tab', { 'tab--active': i === 0 }]}
            role="tab"
            aria-selected={i === 0}
            data-filter={f}
          >
            {f}
          </button>
        ))}
      </div>

      <div class="jposts__grid" data-posts-grid>
        {allPosts.map((post, i) => (
          <a
            class:list={['pcard', { 'pcard--featured': i === 0 }]}
            href={`/blog/${post.id}`}
            data-category={post.data.category}
          >
            <div class="pcard__frame">
              <img src={post.data.image} alt={post.data.title} loading={i === 0 ? 'eager' : 'lazy'} />
            </div>
            <div class="pcard__body">
              <span class="pcard__meta">{post.data.category} · {post.data.date.toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}</span>
              <h3 class="pcard__title">{post.data.title}</h3>
              <p class="pcard__desc">{post.data.description}</p>
              <span class="pcard__cta">Read {i === 0 ? 'the story' : ''} <span aria-hidden="true">&rarr;</span></span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <Enquiry />
  </main>
  <Footer />
</Base>

<style>
  .jhero {
    background-color: var(--color-ink);
    color: var(--color-on-accent);
  }
  .jhero__content {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-block: clamp(3.5rem, 8vw, 6rem) clamp(2.5rem, 5vw, 4rem);
    max-width: 760px;
  }
  .crumbs {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(247, 244, 238, 0.7);
  }
  .crumbs a:hover { color: var(--color-on-accent); }
  .crumbs__here { color: var(--color-accent-soft); }
  .jhero h1 {
    font-size: clamp(2.75rem, 6vw, 4.5rem);
    font-weight: var(--fw-light);
  }
  .jhero__lead {
    color: rgba(247, 244, 238, 0.8);
    line-height: 1.6;
    font-size: 1.0625rem;
  }

  .jposts { background-color: var(--color-surface); }
  .jposts__tabs {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(1rem, 2.5vw, 2.375rem);
    padding-bottom: 3.375rem;
  }
  .tab {
    font-size: var(--text-label);
    font-weight: var(--fw-medium);
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--color-slate);
    padding-bottom: 0.5rem;
    border-bottom: 2px solid transparent;
    transition: color 0.2s ease, border-color 0.2s ease;
  }
  .tab:hover { color: var(--color-ink); }
  .tab--active {
    color: var(--color-ink);
    font-weight: var(--fw-semibold);
    border-bottom-color: var(--color-accent);
  }

  .jposts__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }
  .pcard {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .pcard__body { display: flex; flex-direction: column; gap: 0.5rem; }
  .pcard__frame {
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    margin-bottom: 0.75rem;
  }
  .pcard__frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }
  .pcard:hover .pcard__frame img { transform: scale(1.04); }
  .pcard__meta {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-slate);
  }
  .pcard__title {
    font-size: clamp(1.25rem, 2.2vw, 1.5rem);
    color: var(--color-ink);
    line-height: 1.25;
  }
  .pcard__desc {
    color: var(--color-slate);
    font-size: 0.9375rem;
    line-height: 1.6;
  }
  .pcard__cta {
    margin-top: 0.5rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent);
  }
  .pcard__cta span { transition: transform 0.25s ease; }
  .pcard:hover .pcard__cta span { transform: translateX(4px); }

  /* Featured lead story — spans the full row, larger horizontal layout */
  .pcard--featured {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
    padding-bottom: clamp(2.5rem, 5vw, 3.5rem);
    margin-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-hairline);
  }
  .pcard--featured .pcard__frame { aspect-ratio: 4 / 3; margin-bottom: 0; }
  .pcard--featured .pcard__title {
    font-family: var(--font-display);
    font-weight: var(--fw-light);
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    line-height: 1.2;
  }
  .pcard--featured .pcard__desc { font-size: 1.0625rem; max-width: 46ch; }

  .pcard[hidden] { display: none; }

  @media (max-width: 860px) {
    .jposts__grid { grid-template-columns: 1fr; max-width: 460px; margin-inline: auto; gap: 2.5rem; }
    .pcard--featured { grid-template-columns: 1fr; gap: 1.25rem; }
  }
</style>

<script>
  const cards = Array.from(document.querySelectorAll<HTMLElement>('.pcard'));
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.tab'));

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      tabs.forEach((t) => {
        t.classList.toggle('tab--active', t === tab);
        t.setAttribute('aria-selected', String(t === tab));
      });
      const category = tab.dataset.filter ?? 'All';
      cards.forEach((card) => {
        card.hidden = category !== 'All' && card.dataset.category !== category;
      });
    });
  });
</script>
