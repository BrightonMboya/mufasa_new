---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PlannerFlow from '../components/PlannerFlow.astro';
import { planner, site } from '../data/site';
import { useI18n } from '../i18n';

const { t } = useI18n(Astro);
const title = `${t('Trip Planner')} — ${site.shortName}`;
const description = t(planner.intro.body);
---

<Base title={title} description={description}>
  <Header />
  <PlannerFlow
    steps={planner.steps}
    srTitle={t(planner.intro.title)}
    subject="New trip-planner enquiry"
    fromName="King Mufasa · Trip Planner"
  />
  <Footer />
</Base>
