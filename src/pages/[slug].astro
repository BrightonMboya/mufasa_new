---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const pages = await getCollection('legal');
  return pages.map((page) => ({ params: { slug: page.id }, props: { page } }));
}

const { page } = Astro.props;
const { Content } = await render(page);
const title = `${page.data.title} — ${site.shortName}`;
---

<Base title={title} description={page.data.description}>
  <Header />
  <main>
    <section class="lhero section wrap">
      <h1>{page.data.title}</h1>
    </section>

    <section class="lbody section wrap">
      <div class="prose">
        <Content />
      </div>
    </section>
  </main>
  <Footer />
</Base>

<style>
  .lhero { background-color: var(--color-ground); max-width: 900px; margin-inline: auto; padding-bottom: 0; }
  .lhero h1 { font-size: clamp(2.25rem, 5vw, 3.5rem); font-weight: var(--fw-light); color: var(--color-ink); }

  .lbody { background-color: var(--color-ground); padding-top: 0; }
  .lbody .prose { max-width: 900px; margin-inline: auto; }
</style>
