---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Enquiry from '../../components/Enquiry.astro';
import { activities, site } from '../../data/site';

const title = `Add-On Activities — ${site.shortName}`;
const description = 'Balloon safaris, canoeing, cultural visits and more — bookable extras that layer onto any Tanzania safari.';
---

<Base title={title} description={description}>
  <Header />
  <main>
    <section class="ahero">
      <div class="ahero__content wrap">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/">Home</a><span>/</span><span class="crumbs__here">Activities</span>
        </nav>
        <span class="eyebrow" style="color: var(--color-accent-soft)">Add-On Activities</span>
        <h1>Make the safari your own</h1>
        <p class="ahero__lead">Bookable extras that layer onto any itinerary — a dawn balloon flight, a canoe past elephant, a night drive for the nocturnal hunters. Add one, or several.</p>
      </div>
    </section>

    <section class="agrid section wrap">
      {activities.map((a, i) => (
        <a class:list={['acard', { 'acard--featured': i === 0 }]} href={`/activities/${a.slug}`}>
          <div class="acard__frame">
            <img src={a.image} alt={a.title} loading={i === 0 ? 'eager' : 'lazy'} />
          </div>
          <div class="acard__body">
            <h3 class="acard__title">{a.title}</h3>
            <p class="acard__tagline">{a.tagline}</p>
            <span class="acard__cta">Learn more <span aria-hidden="true">&rarr;</span></span>
          </div>
        </a>
      ))}
    </section>

    <Enquiry />
  </main>
  <Footer />
</Base>

<style>
  .ahero {
    background-color: var(--color-ink);
    color: var(--color-on-accent);
  }
  .ahero__content {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-block: clamp(3.5rem, 8vw, 6rem) clamp(2.5rem, 5vw, 4rem);
    max-width: 760px;
  }
  .crumbs {
    display: flex; align-items: center; gap: 0.6rem;
    font-family: var(--font-mono); font-size: 0.6875rem; letter-spacing: 0.16em; text-transform: uppercase;
    color: rgba(247, 244, 238, 0.7);
  }
  .crumbs a:hover { color: var(--color-on-accent); }
  .crumbs__here { color: var(--color-accent-soft); }
  .ahero h1 { font-size: clamp(2.75rem, 6vw, 4.5rem); font-weight: var(--fw-light); }
  .ahero__lead { color: rgba(247, 244, 238, 0.8); line-height: 1.6; font-size: 1.0625rem; }

  .agrid {
    background-color: var(--color-surface);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }
  .acard { display: flex; flex-direction: column; gap: 0.5rem; }
  .acard__body { display: flex; flex-direction: column; gap: 0.5rem; }
  .acard__frame { width: 100%; aspect-ratio: 4 / 3; overflow: hidden; margin-bottom: 0.75rem; }
  .acard__frame img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s ease; }
  .acard:hover .acard__frame img { transform: scale(1.04); }
  .acard__title { font-size: clamp(1.375rem, 2.5vw, 1.75rem); color: var(--color-ink); }
  .acard__tagline { color: var(--color-slate); line-height: 1.6; font-size: 0.9375rem; }
  .acard__cta {
    margin-top: 0.5rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent);
  }
  .acard__cta span { transition: transform 0.25s ease; }
  .acard:hover .acard__cta span { transform: translateX(4px); }

  .acard--featured {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
    padding-bottom: clamp(2.5rem, 5vw, 3.5rem);
    margin-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-hairline);
  }
  .acard--featured .acard__frame { aspect-ratio: 16 / 10; margin-bottom: 0; }
  .acard--featured .acard__title { font-size: clamp(1.75rem, 3.5vw, 2.25rem); }
  .acard--featured .acard__tagline { font-size: 1.0625rem; max-width: 42ch; }

  @media (max-width: 860px) {
    .agrid { grid-template-columns: 1fr; max-width: 460px; margin-inline: auto; gap: 3rem; }
    .acard--featured { grid-template-columns: 1fr; gap: 1.25rem; }
  }
</style>
