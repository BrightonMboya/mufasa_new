---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Enquiry from '../components/Enquiry.astro';
import JourneyEnquiryModal from '../components/JourneyEnquiryModal.astro';
import { trekking, site } from '../data/site';

const title = `Trekking — Kilimanjaro & Mount Meru | ${site.shortName}`;
const description = trekking.intro.lead;
---

<Base title={title} description={description}>
  <Header />
  <main>
    <!-- Hero -->
    <section class="thero">
      <img class="thero__img" src={trekking.intro.heroImage} alt="Mount Kilimanjaro" fetchpriority="high" />
      <div class="thero__scrim"></div>
      <div class="thero__content wrap">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/">Home</a><span>/</span><span class="crumbs__here">Trekking</span>
        </nav>
        <span class="eyebrow" style="color: var(--color-accent-soft)">{trekking.intro.eyebrow}</span>
        <h1>{trekking.intro.title}</h1>
      </div>
    </section>

    <!-- Intro -->
    <section class="tintro section wrap">
      <p class="tintro__lead">{trekking.intro.lead}</p>
      <p class="tintro__body">{trekking.intro.body}</p>
    </section>

    <!-- Routes -->
    <section class="troutes section wrap">
      <h2 class="troutes__title">The routes</h2>
      <div class="troutes__grid">
        {trekking.routes.map((r) => (
          <article class="trek">
            <div class="trek__frame">
              <img src={r.image} alt={r.name} loading="lazy" />
            </div>
            <span class="trek__meta">{r.meta}</span>
            <h3 class="trek__name">{r.name}</h3>
            <p class="trek__summary">{r.summary}</p>
            <ul class="trek__highlights">
              {r.highlights.map((h) => <li>{h}</li>)}
            </ul>
            <div class="trek__foot">
              <span class="trek__price">
                <span class="trek__price-label">From / person</span>
                <span class="trek__price-value">{r.priceFrom}</span>
              </span>
              <button type="button" class="pill pill--outline trek__cta" data-emodal-open data-journey={r.name}>Enquire</button>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- What's included -->
    <section class="tincl section wrap">
      <h2>Every trek includes</h2>
      <ul class="tincl__list">
        {trekking.included.map((x) => <li>{x}</li>)}
      </ul>
    </section>

    <Enquiry />
  </main>
  <Footer />

  <JourneyEnquiryModal journeyTitle={trekking.routes[0]?.name ?? 'Trekking'} />
</Base>

<style>
  .thero {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: clamp(440px, 64vh, 600px);
    overflow: hidden;
    background-color: var(--color-ink);
    isolation: isolate;
  }
  .thero__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
  }
  .thero__scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(180deg, rgba(20, 24, 21, 0.32) 0%, rgba(20, 24, 21, 0.18) 45%, rgba(20, 24, 21, 0.82) 100%);
  }
  .thero__content {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-block: clamp(2.5rem, 5vw, 3.75rem);
  }
  .crumbs {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(247, 244, 238, 0.7);
  }
  .crumbs a:hover { color: var(--color-on-accent); }
  .crumbs__here { color: var(--color-accent-soft); }
  .thero h1 {
    font-size: clamp(2.75rem, 7vw, 5.5rem);
    color: var(--color-on-accent);
    font-weight: var(--fw-light);
  }

  /* Intro */
  .tintro {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
    background-color: var(--color-ground);
  }
  .tintro__lead {
    font-family: var(--font-display);
    font-weight: var(--fw-light);
    font-size: clamp(1.6rem, 3.5vw, 2.5rem);
    line-height: 1.3;
    letter-spacing: -0.02em;
    color: var(--color-ink);
  }
  .tintro__body {
    color: var(--color-slate);
    line-height: 1.7;
  }

  /* Routes */
  .troutes { background-color: var(--color-surface); }
  .troutes__title {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: var(--fw-light);
    color: var(--color-ink);
    margin-bottom: 3rem;
  }
  .troutes__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }
  .trek {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .trek__frame {
    width: 100%;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    margin-bottom: 0.75rem;
  }
  .trek__frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }
  .trek:hover .trek__frame img { transform: scale(1.04); }
  .trek__meta {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-slate);
  }
  .trek__name {
    font-size: clamp(1.375rem, 2.5vw, 1.75rem);
    color: var(--color-ink);
  }
  .trek__summary {
    color: var(--color-slate);
    line-height: 1.6;
    font-size: 0.9375rem;
  }
  .trek__highlights {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: 0.25rem;
  }
  .trek__highlights li {
    position: relative;
    padding-left: 1.4rem;
    font-size: 0.875rem;
    color: var(--color-ink);
  }
  .trek__highlights li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--color-accent);
  }
  .trek__foot {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1.25rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-hairline);
  }
  .trek__price { display: flex; flex-direction: column; gap: 0.3rem; }
  .trek__price-label {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-slate);
  }
  .trek__price-value { font-family: var(--font-mono); font-size: 1.125rem; color: var(--color-ink); }
  .trek__cta { padding: 0.7rem 1.5rem; }

  /* Included */
  .tincl { background-color: var(--color-ground); }
  .tincl h2 {
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    font-weight: var(--fw-light);
    color: var(--color-ink);
    margin-bottom: 2rem;
  }
  .tincl__list {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem 3rem;
    max-width: 900px;
  }
  .tincl__list li {
    position: relative;
    padding-left: 2rem;
    color: var(--color-ink);
    line-height: 1.5;
  }
  .tincl__list li::before {
    content: '+';
    position: absolute;
    left: 0;
    top: 0.05em;
    font-family: var(--font-mono);
    font-weight: 700;
    color: var(--color-accent);
  }

  @media (max-width: 860px) {
    .tintro { grid-template-columns: 1fr; }
    .troutes__grid { grid-template-columns: 1fr; max-width: 460px; margin-inline: auto; gap: 3rem; }
    .tincl__list { grid-template-columns: 1fr; }
  }
</style>
