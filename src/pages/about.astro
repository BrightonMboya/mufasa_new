---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Enquiry from '../components/Enquiry.astro';
import { about, site } from '../data/site';

const title = `About — ${site.name}`;
const description = about.lead;
---

<Base title={title} description={description}>
  <Header />
  <main>
    <!-- Hero -->
    <section class="ahero">
      <img class="ahero__img" src={about.hero.image} alt="" fetchpriority="high" />
      <div class="ahero__scrim"></div>
      <div class="ahero__content wrap">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/">Home</a><span>/</span><span class="crumbs__here">About Us</span>
        </nav>
        <span class="eyebrow" style="color: var(--color-accent-soft)">{about.hero.eyebrow}</span>
        <h1>{about.hero.title}</h1>
      </div>
    </section>

    <!-- Lead + story -->
    <section class="story section wrap">
      <p class="story__lead">{about.lead}</p>
      <div class="story__body">
        {about.story.map((p) => <p>{p}</p>)}
      </div>
    </section>

    <!-- Stats -->
    <section class="stats section wrap">
      <div class="stats__grid">
        {about.stats.map((s) => (
          <div class="stat">
            <span class="stat__value">{s.value}</span>
            <span class="stat__label">{s.label}</span>
          </div>
        ))}
      </div>
    </section>

    <!-- Guides -->
    <section id="guides" class="slab section wrap">
      <div class="slab__media">
        <img src={about.guides.image} alt={about.guides.title} loading="lazy" />
      </div>
      <div class="slab__text">
        <h2>{about.guides.title}</h2>
        <p>{about.guides.body}</p>
      </div>
    </section>

    <!-- Operations -->
    <section id="operations" class="slab slab--reverse section wrap">
      <div class="slab__media">
        <img src={about.operations.image} alt={about.operations.title} loading="lazy" />
      </div>
      <div class="slab__text">
        <h2>{about.operations.title}</h2>
        <p>{about.operations.body}</p>
      </div>
    </section>

    <Enquiry />
  </main>
  <Footer />
</Base>

<style>
  .ahero {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: clamp(400px, 56vh, 520px);
    overflow: hidden;
    background-color: var(--color-ink);
    isolation: isolate;
  }
  .ahero__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
  }
  .ahero__scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(180deg, rgba(20, 24, 21, 0.4) 0%, rgba(20, 24, 21, 0.25) 45%, rgba(20, 24, 21, 0.85) 100%);
  }
  .ahero__content {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-block: clamp(2.5rem, 5vw, 3.75rem);
  }
  .crumbs {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(247, 244, 238, 0.7);
  }
  .crumbs a:hover { color: var(--color-on-accent); }
  .crumbs__here { color: var(--color-accent-soft); }
  .ahero h1 {
    font-size: clamp(2.75rem, 7vw, 5.5rem);
    color: var(--color-on-accent);
    font-weight: var(--fw-light);
  }

  /* Lead + story */
  .story {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2.5rem, 6vw, 5.5rem);
    align-items: start;
    background-color: var(--color-ground);
  }
  .story__lead {
    font-family: var(--font-display);
    font-weight: var(--fw-light);
    font-size: clamp(1.75rem, 3.5vw, 2.625rem);
    line-height: 1.28;
    letter-spacing: -0.02em;
    color: var(--color-ink);
  }
  .story__body {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    color: var(--color-slate);
    line-height: 1.7;
  }

  /* Stats */
  .stats { background-color: var(--color-ink); }
  .stats__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
  }
  .stat {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-right: 1.5rem;
    border-left: 1px solid rgba(247, 244, 238, 0.18);
    padding-left: 1.5rem;
  }
  .stat__value {
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 6vw, 4rem);
    line-height: 1;
    color: var(--color-accent-soft);
  }
  .stat__label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(247, 244, 238, 0.75);
  }

  /* Slabs */
  .slab {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: center;
    background-color: var(--color-surface);
  }
  .slab--reverse { background-color: var(--color-ground); }
  .slab--reverse .slab__media { order: 2; }
  .slab__media { overflow: hidden; }
  .slab__media img {
    width: 100%;
    height: 100%;
    max-height: 520px;
    object-fit: cover;
  }
  .slab__text { display: flex; flex-direction: column; gap: 1.5rem; }
  .slab__text h2 {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: var(--fw-light);
    color: var(--color-ink);
  }
  .slab__text p { color: var(--color-slate); line-height: 1.7; }

  @media (max-width: 860px) {
    .story { grid-template-columns: 1fr; }
    .stats__grid { grid-template-columns: 1fr 1fr; gap: 2.5rem 1.5rem; }
    .slab, .slab--reverse { grid-template-columns: 1fr; }
    .slab--reverse .slab__media { order: 0; }
  }
</style>
