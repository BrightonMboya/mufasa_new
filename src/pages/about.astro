---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Enquiry from '../components/Enquiry.astro';
import { about as aboutData, site } from '../data/site';
import { useI18n } from '../i18n';

const { t, l } = useI18n(Astro);
const about = l(aboutData);
const title = t('About — {name}', { name: site.name });
const description = `${about.lead.title} ${about.lead.body}`;
---

<Base title={title} description={description}>
  <Header />
  <main>
    <!-- Hero -->
    <section class="ahero">
      <div class="ahero__content wrap">
        <span class="eyebrow" style="color: var(--color-accent-soft)">{about.hero.eyebrow}</span>
        <h1>{about.hero.title}</h1>
      </div>
    </section>

    <!-- Lead + story -->
    <section class="story section wrap">
      <div class="story__lead">
        <h2 class="story__title">{about.lead.title}</h2>
        <p class="story__tagline">{about.lead.body}</p>
      </div>
      <div class="story__body">
        {about.story.map((p) => <p>{p}</p>)}
      </div>
    </section>

    <!-- Stats -->
    <section class="stats section wrap">
      <div class="stats__grid">
        {about.stats.map((s) => (
          <div class="stat">
            <span class="stat__value">{s.value}</span>
            <span class="stat__label">{s.label}</span>
          </div>
        ))}
      </div>
    </section>

    <!-- Guides -->
    <section id="guides" class="slab section wrap">
      <div class="slab__media">
        <img src={about.guides.image} alt={about.guides.title} loading="lazy" decoding="async" />
      </div>
      <div class="slab__text">
        <h2>{about.guides.title}</h2>
        <p>{about.guides.body}</p>
      </div>
    </section>

    <!-- Operations -->
    <section id="operations" class="slab slab--reverse section wrap">
      <div class="slab__media">
        <img src={about.operations.image} alt={about.operations.title} loading="lazy" decoding="async" />
      </div>
      <div class="slab__text">
        <h2>{about.operations.title}</h2>
        {about.operations.body.map((p) => <p>{p}</p>)}
      </div>
    </section>

    <Enquiry />
  </main>
  <Footer />
</Base>

<style>
  /* A plain dark band, matching the All Journeys hero. */
  .ahero {
    background-color: var(--color-ink);
  }
  .ahero__content {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-block: clamp(3.5rem, 8vw, 6rem) clamp(2.5rem, 5vw, 4rem);
    max-width: 760px;
  }
  .ahero h1 {
    font-size: clamp(2.75rem, 6vw, 4.5rem);
    color: var(--color-on-accent);
    font-weight: var(--fw-light);
  }

  /* Lead + story */
  .story {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2.5rem, 6vw, 5.5rem);
    align-items: start;
    background-color: var(--color-ground);
  }
  .story__lead {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .story__title {
    font-family: var(--font-display);
    font-weight: var(--fw-light);
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--color-ink);
  }
  .story__tagline {
    color: var(--color-slate);
    font-size: 1.125rem;
    line-height: 1.6;
  }
  .story__body {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    color: var(--color-slate);
    line-height: 1.7;
  }

  /* Stats */
  .stats { background-color: var(--color-ink); }
  .stats__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
  }
  .stat {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-right: 1.5rem;
    border-left: 1px solid rgba(247, 244, 238, 0.18);
    padding-left: 1.5rem;
  }
  .stat__value {
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 6vw, 4rem);
    line-height: 1;
    color: var(--color-accent-soft);
  }
  .stat__label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(247, 244, 238, 0.75);
  }

  /* Slabs */
  .slab {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: center;
    background-color: var(--color-surface);
  }
  .slab--reverse { background-color: var(--color-ground); }
  .slab--reverse .slab__media { order: 2; }
  .slab__media { overflow: hidden; }
  .slab__media img {
    width: 100%;
    height: 100%;
    max-height: 520px;
    object-fit: cover;
  }
  .slab__text { display: flex; flex-direction: column; gap: 1.5rem; }
  .slab__text h2 {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: var(--fw-light);
    color: var(--color-ink);
  }
  .slab__text p { color: var(--color-slate); line-height: 1.7; }

  @media (max-width: 860px) {
    .story { grid-template-columns: 1fr; }
    .stats__grid { grid-template-columns: 1fr 1fr; gap: 2.5rem 1.5rem; }
    .slab, .slab--reverse { grid-template-columns: 1fr; }
    .slab--reverse .slab__media { order: 0; }
  }
</style>
