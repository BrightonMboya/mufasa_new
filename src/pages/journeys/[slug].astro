---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Enquiry from '../../components/Enquiry.astro';
import RouteMap from '../../components/RouteMap.astro';
import JourneyEnquiryModal from '../../components/JourneyEnquiryModal.astro';
import LodgeLightbox from '../../components/LodgeLightbox.astro';
import { journeys, site, accommodationDirectory } from '../../data/site';

export function getStaticPaths() {
  return journeys.map((j) => ({ params: { slug: j.slug }, props: { journey: j } }));
}

// Day objects only carry lodge photos; the UUID baked into the image URL
// (assets.makisala.com/accommodations/<uuid>/...) is the join key back to
// the real lodge name + description in accommodationDirectory.
function lodgeFor(images?: string[]) {
  const match = images?.[0]?.match(/accommodations\/([0-9a-f-]{36})\//);
  return match ? accommodationDirectory[match[1]] : undefined;
}

const { journey } = Astro.props;
const stops = journey.days.map((d) => ({ days: d.days, place: d.place, note: d.note, optional: d.optional }));
const title = `${journey.title} — ${journey.nights + 1} Days / ${journey.nights} ${journey.nights === 1 ? 'Night' : 'Nights'} in Tanzania | ${site.shortName}`;

// north-to-sea is our packages hub: hero only, then every priced package
// split by how you reach it — overland from Arusha, or flown in from Zanzibar.
const isPackagesHub = journey.slug === 'north-to-sea';
const northernCircuitPackages = journeys.filter((j) => j.packageGroup === 'northern-circuit');
const flyInPackages = journeys.filter((j) => j.packageGroup === 'fly-in');

// Curated cross-sell set — shown on every other journey page except its own.
const FEATURED_SLUGS = [
  '7-day-tanzania-drive-in-fly-out-luxury-safari',
  '6-day-the-great-wildebeest-migration-safari',
  '5-days-manyara-serengeti-ngorongoro-best-luxury-safari',
  '5-days-tanzania-family-safari',
  '7-days-tanzania-family-safari',
];
const related = journeys.filter((j) => FEATURED_SLUGS.includes(j.slug) && j.slug !== journey.slug);
---

<Base title={title} description={journey.summary}>
  <Header />
  <main>
    <!-- Cinematic hero -->
    <section class="dhero">
      <img class="dhero__img" src={journey.image} alt={journey.title} fetchpriority="high" data-hero-img />
      <div class="dhero__scrim"></div>

      <div class="dhero__top wrap">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/">Home</a><span>/</span><a href="/#journeys">Safaris</a><span>/</span><span class="crumbs__here">{journey.title}</span>
        </nav>
      </div>

      <div class="dhero__content wrap">
        <span class="dhero__cat">{journey.category}</span>
        <h1>{journey.title}</h1>
        <div class="dhero__meta">
          <span class="dhero__meta-item">
            <svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <rect x="2" y="3.2" width="12" height="10.3" rx="1" stroke="currentColor" stroke-width="1.2"/>
              <path d="M2 6.3h12M5.3 1.5v2.6M10.7 1.5v2.6" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
            </svg>
            {journey.nights + 1} Days / {journey.nights} {journey.nights === 1 ? 'Night' : 'Nights'}
          </span>
          <span class="dhero__dot"></span>
          <span class="dhero__meta-item">
            <svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M8 14.5s5-4.6 5-8.3A5 5 0 0 0 3 6.2c0 3.7 5 8.3 5 8.3Z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/>
              <circle cx="8" cy="6.1" r="1.8" stroke="currentColor" stroke-width="1.2"/>
            </svg>
            {site.region}
          </span>
        </div>
      </div>

      {!isPackagesHub && (
        <div class="dhero__scroll" aria-hidden="true">
          <span>Scroll</span>
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none">
            <path d="M3.5 6 8 11l4.5-5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
      )}
    </section>

    {!isPackagesHub && (
      <Fragment>
        <!-- Introduction + trip stats -->
        <section class="intro section wrap">
          <p class="eyebrow" data-reveal>The Journey</p>
          <p class="intro__summary" data-reveal>{journey.summary}</p>
          <div class="intro__stats" data-reveal>
            <div class="stat">
              <span class="stat__label">Duration</span>
              <span class="stat__value">{journey.nights + 1} Days / {journey.nights} {journey.nights === 1 ? 'Night' : 'Nights'}</span>
            </div>
            <span class="stat__divider"></span>
            <div class="stat">
              <span class="stat__label">Route</span>
              <span class="stat__value">{journey.days.filter((d) => !d.optional).length} grounds{journey.days.some((d) => d.optional) ? ' + extension' : ''}</span>
            </div>
            <span class="stat__divider"></span>
            <div class="stat">
              <span class="stat__label">From / Person</span>
              <span class="stat__value stat__value--price">{journey.priceFrom}</span>
            </div>
          </div>
          <button type="button" class="pill pill--accent intro__cta" data-emodal-open>
            Enquire about this journey
            <svg class="cta-arrow" width="14" height="14" viewBox="0 0 16 16" fill="none">
              <path d="M6 3.5 11 8l-5 4.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        </section>

        <!-- Route -->
        <section class="rstrip section wrap">
          <div class="rstrip__head">
            <h2 class="rstrip__title" data-reveal>Your Route</h2>
            <div class="itin__legend">
              <span class="legend"><span class="legend__line legend__line--solid"></span>Core route</span>
              {journey.days.some((d) => d.optional) && (
                <span class="legend"><span class="legend__line legend__line--dashed"></span>Extension</span>
              )}
            </div>
          </div>
          <RouteMap stops={stops} compact />
        </section>

        <!-- Day by day -->
        <section class="dbd">
          <div class="dbd__head wrap">
            <p class="eyebrow" data-reveal>Day by Day</p>
            <h2 class="dbd__title" data-reveal>The Full Itinerary</h2>
          </div>

          {journey.days.map((d, i) => {
            const bandImage = d.bandImage || (d.images && d.images[0]) || journey.image;
            const lodge = lodgeFor(d.images);
            return (
              <Fragment>
                <article class="day">
                  <div class="day__band">
                    <img
                      class="day__band-img"
                      src={bandImage}
                      alt={d.place}
                      loading={i === 0 ? 'eager' : 'lazy'}
                    />
                    <div class="day__band-scrim"></div>
                    <div class="day__band-content wrap">
                      <div class="day__band-row" data-reveal>
                        <span class="day__num">{String(i + 1).padStart(2, '0')}</span>
                        <div class="day__band-meta">
                          <p class="day__range">
                            {d.days}
                            {d.optional && <span class="day__tag">Optional</span>}
                          </p>
                          <p class="day__nights">{d.nights} {d.nights === 1 ? 'night' : 'nights'}</p>
                        </div>
                      </div>
                      <h3 class="day__place" data-reveal>{d.place}</h3>
                    </div>
                  </div>

                  <div class="day__narrative wrap">
                    <p class="day__note" data-reveal>{d.note}</p>
                  </div>

                  {d.images && d.images.length > 0 && (
                    <div class:list={['day__stay', { 'day__stay--reverse': i % 2 === 1 }]}>
                      <div class="day__gallery" data-gallery>
                        {d.images.map((src, gi) => (
                          <img
                            src={src}
                            alt={lodge?.name ?? d.place}
                            loading="lazy"
                            class:list={['day__gallery-img', { 'is-active': gi === 0 }]}
                            data-gallery-slide
                          />
                        ))}
                        {d.images.length > 1 && (
                          <Fragment>
                            <button type="button" class="day__gallery-nav day__gallery-nav--prev" data-gallery-prev aria-label="Previous photo">&#8249;</button>
                            <button type="button" class="day__gallery-nav day__gallery-nav--next" data-gallery-next aria-label="Next photo">&#8250;</button>
                            <div class="day__gallery-dots" data-gallery-dots>
                              {d.images.map((_, gi) => (
                                <button
                                  type="button"
                                  class:list={['day__gallery-dot', { 'is-active': gi === 0 }]}
                                  data-gallery-dot
                                  aria-label={`Photo ${gi + 1}`}
                                ></button>
                              ))}
                            </div>
                          </Fragment>
                        )}
                        <button
                          type="button"
                          class="day__gallery-expand"
                          data-lodge-gallery={JSON.stringify(d.images)}
                          aria-label={`View all ${d.images.length} photos`}
                        >
                          {d.images.length} photos
                        </button>
                      </div>
                      <div class="day__stay-content">
                        <p class="eyebrow" data-reveal>Where You'll Stay</p>
                        <h4 class="day__stay-title" data-reveal>{lodge?.name ?? d.place}</h4>
                        {lodge?.description && (
                          <p class="day__stay-desc" data-reveal>{lodge.description}</p>
                        )}
                        <p class="day__stay-meta" data-reveal>
                          {lodge?.name && <Fragment>{d.place} · </Fragment>}
                          {d.nights} {d.nights === 1 ? 'night' : 'nights'}{d.optional ? ' · Optional extension' : ''}
                        </p>
                      </div>
                    </div>
                  )}
                </article>

                {i < journey.days.length - 1 && (
                  <div class="day__divider" aria-hidden="true">
                    <span class="day__divider-line"></span>
                    <span class="day__divider-dot"></span>
                    <span class="day__divider-line"></span>
                  </div>
                )}
              </Fragment>
            );
          })}
        </section>

        <!-- Pricing + inclusions -->
        <section class="pricing">
          <div class="wrap pricing__grid">
            <div class="pricing__price" data-reveal>
              <p class="eyebrow pricing__eyebrow">Investment</p>
              <p class="pricing__amount">{journey.priceFrom}</p>
              <p class="pricing__caption">
                Per person, sharing — full board, park fees, and a private guide for the whole route.
              </p>
              <button type="button" class="pill pill--accent pricing__cta" data-emodal-open>
                Enquire about this journey
                <svg class="cta-arrow" width="14" height="14" viewBox="0 0 16 16" fill="none">
                  <path d="M6 3.5 11 8l-5 4.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
            </div>

            <div class="pricing__terms">
              <div class="pricing__col" data-reveal>
                <div class="pricing__col-head">
                  <span class="pricing__badge pricing__badge--yes">&#10003;</span>
                  <h3>Included</h3>
                </div>
                <ul>
                  {journey.included.map((x) => <li>{x}</li>)}
                </ul>
              </div>
              <div class="pricing__col" data-reveal>
                <div class="pricing__col-head">
                  <span class="pricing__badge pricing__badge--no">&#10005;</span>
                  <h3>Not Included</h3>
                </div>
                <ul>
                  {journey.excluded.map((x) => <li>{x}</li>)}
                </ul>
              </div>
            </div>
          </div>
        </section>
      </Fragment>
    )}

    {/* Packages hub: every priced route, grouped by how you reach it */}
    {isPackagesHub ? (
      <section class="related related--hub section wrap">
        <h2 class="related__title">Popular Packages</h2>

        <div class="pkg-group">
          <h3 class="pkg-group__title">Northern Circuit</h3>
          <div class="related__grid">
            {northernCircuitPackages.map((r) => (
              <a class="rcard" href={`/journeys/${r.slug}`}>
                <div class="rcard__frame">
                  <img src={r.image} alt={r.packageTitle ?? r.title} loading="lazy" />
                  <span class="rcard__price">{r.priceFrom} <span class="rcard__price-unit">/ person</span></span>
                </div>
                <span class="rcard__meta">{r.meta}</span>
                <h3 class="rcard__title">{r.packageTitle ?? r.title}</h3>
                <span class="rcard__cta">View itinerary</span>
              </a>
            ))}
          </div>
        </div>

        <div class="pkg-group">
          <h3 class="pkg-group__title">Fly-In, Fly-Out from Zanzibar</h3>
          <div class="related__grid">
            {flyInPackages.map((r) => (
              <a class="rcard" href={`/journeys/${r.slug}`}>
                <div class="rcard__frame">
                  <img src={r.image} alt={r.packageTitle ?? r.title} loading="lazy" />
                  <span class="rcard__price">{r.priceFrom} <span class="rcard__price-unit">/ person</span></span>
                </div>
                <span class="rcard__meta">{r.meta}</span>
                <h3 class="rcard__title">{r.packageTitle ?? r.title}</h3>
                <span class="rcard__cta">View itinerary</span>
              </a>
            ))}
          </div>
        </div>
      </section>
    ) : (
      related.length > 0 && (
        <section class="related section wrap">
          <h2 class="related__title">Popular Packages</h2>
          <div class="related__grid">
            {related.map((r) => (
              <a class="rcard" href={`/journeys/${r.slug}`}>
                <div class="rcard__frame">
                  <img src={r.image} alt={r.title} loading="lazy" />
                  <span class="rcard__price">{r.priceFrom} <span class="rcard__price-unit">/ person</span></span>
                </div>
                <span class="rcard__meta">{r.meta}</span>
                <h3 class="rcard__title">{r.title}</h3>
                <span class="rcard__cta">View itinerary</span>
              </a>
            ))}
          </div>
        </section>
      )
    )}

    <Enquiry />
  </main>
  <Footer />
  {!isPackagesHub && <JourneyEnquiryModal journeyTitle={journey.title} />}
  {!isPackagesHub && <LodgeLightbox />}
</Base>

<script>
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Scroll-reveal (fade + rise), mirroring the Discovery theme's whileInView motion
  if (!prefersReducedMotion && 'IntersectionObserver' in window) {
    const revealEls = document.querySelectorAll('[data-reveal]');
    revealEls.forEach((el) => el.classList.add('reveal-init'));
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15, rootMargin: '0px 0px -60px 0px' },
    );
    revealEls.forEach((el) => observer.observe(el));
  }

  // Hero parallax
  if (!prefersReducedMotion) {
    const heroImg = document.querySelector('[data-hero-img]');
    if (heroImg instanceof HTMLElement) {
      let ticking = false;
      const update = () => {
        const y = Math.min(window.scrollY, window.innerHeight) * 0.25;
        heroImg.style.transform = `translateY(${y}px)`;
        ticking = false;
      };
      window.addEventListener(
        'scroll',
        () => {
          if (!ticking) {
            requestAnimationFrame(update);
            ticking = true;
          }
        },
        { passive: true },
      );
    }
  }

  // Accommodation galleries — auto-advancing, pauses on hover
  document.querySelectorAll('[data-gallery]').forEach((gallery) => {
    const slides = Array.from(gallery.querySelectorAll('[data-gallery-slide]'));
    const dots = Array.from(gallery.querySelectorAll('[data-gallery-dot]'));
    if (slides.length <= 1) return;
    let index = 0;
    let timer = null;

    const show = (next) => {
      index = (next + slides.length) % slides.length;
      slides.forEach((slide, i) => slide.classList.toggle('is-active', i === index));
      dots.forEach((dot, i) => dot.classList.toggle('is-active', i === index));
    };
    const stopAutoplay = () => {
      if (timer) window.clearInterval(timer);
      timer = null;
    };
    const startAutoplay = () => {
      if (prefersReducedMotion) return;
      stopAutoplay();
      timer = window.setInterval(() => show(index + 1), 5000);
    };

    gallery.querySelector('[data-gallery-prev]')?.addEventListener('click', () => {
      show(index - 1);
      startAutoplay();
    });
    gallery.querySelector('[data-gallery-next]')?.addEventListener('click', () => {
      show(index + 1);
      startAutoplay();
    });
    dots.forEach((dot, i) =>
      dot.addEventListener('click', () => {
        show(i);
        startAutoplay();
      }),
    );
    gallery.addEventListener('mouseenter', stopAutoplay);
    gallery.addEventListener('mouseleave', startAutoplay);

    startAutoplay();
  });
</script>

<style>
  /* Scroll-reveal utility — default visible; JS opts elements in before observing,
     so content never gets stuck hidden if scripting is unavailable. */
  .reveal-init {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.8s cubic-bezier(0.25, 0.1, 0.25, 1), transform 0.8s cubic-bezier(0.25, 0.1, 0.25, 1);
  }
  .reveal-init.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Cinematic hero */
  .dhero {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 100vh;
    overflow: hidden;
    background-color: var(--color-ink);
    isolation: isolate;
  }
  .dhero__img {
    position: absolute;
    top: -5%;
    left: 0;
    width: 100%;
    height: 110%;
    object-fit: cover;
    z-index: -2;
    will-change: transform;
  }
  .dhero__scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(180deg, rgba(20, 24, 21, 0.45) 0%, rgba(20, 24, 21, 0.15) 40%, rgba(20, 24, 21, 0.85) 100%);
  }
  .dhero__top {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 2;
    padding-block: clamp(1.5rem, 3vw, 2rem);
  }
  .crumbs {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(247, 244, 238, 0.7);
  }
  .crumbs a:hover { color: var(--color-on-accent); }
  .crumbs__here { color: var(--color-accent-soft); }
  .dhero__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-block: clamp(2.5rem, 5vw, 3.75rem);
  }
  .dhero__cat {
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(247, 244, 238, 0.85);
    animation: heroFade 0.7s ease 0.15s both;
  }
  .dhero h1 {
    font-size: clamp(3rem, 7.5vw, 6.5rem);
    color: var(--color-on-accent);
    font-weight: var(--fw-light);
    animation: heroRise 0.9s cubic-bezier(0.25, 0.1, 0.25, 1) 0.25s both;
  }
  .dhero__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.9rem;
    margin-top: 0.5rem;
    color: rgba(247, 244, 238, 0.85);
    animation: heroFade 0.7s ease 0.55s both;
  }
  .dhero__meta-item {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9375rem;
  }
  .dhero__dot {
    width: 4px;
    height: 4px;
    border-radius: var(--radius-full);
    background-color: rgba(247, 244, 238, 0.4);
  }
  .dhero__scroll {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    animation: heroFade 0.7s ease 1s both;
  }
  .dhero__scroll span {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: rgba(247, 244, 238, 0.55);
  }
  .dhero__scroll svg {
    color: rgba(247, 244, 238, 0.55);
    animation: bounce 2s ease-in-out infinite;
  }
  @keyframes heroRise {
    from { opacity: 0; transform: translateY(28px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes heroFade {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  @keyframes bounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(6px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .dhero__content, .dhero__cat, .dhero h1, .dhero__meta, .dhero__scroll, .dhero__scroll svg {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
  }

  /* CTA arrow flourish */
  .cta-arrow { transition: transform 0.25s ease; }
  .pill:hover .cta-arrow { transform: translateX(3px); }

  /* Introduction + trip stats */
  .intro {
    background-color: var(--color-ground);
    text-align: center;
  }
  .intro__summary {
    max-width: 44rem;
    margin: 1.75rem auto 0;
    font-family: var(--font-display);
    font-weight: var(--fw-light);
    font-size: clamp(1.375rem, 2.6vw, 1.875rem);
    line-height: 1.5;
    letter-spacing: -0.01em;
    color: var(--color-ink);
  }
  .intro__stats {
    margin-top: 3rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0 2rem;
    row-gap: 1.5rem;
  }
  .stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    padding-inline: 0.5rem;
  }
  .stat__label {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-slate);
  }
  .stat__value {
    font-size: 1.0625rem;
    color: var(--color-ink);
  }
  .stat__value--price {
    font-family: var(--font-mono);
    font-size: 1.1875rem;
  }
  .stat__divider {
    width: 1px;
    height: 2rem;
    background-color: var(--color-hairline);
  }
  .intro__cta { margin-top: 2.75rem; }

  /* Route */
  .rstrip {
    background-color: var(--color-ink);
    color: var(--color-on-accent);
  }
  .rstrip__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
    margin-bottom: 2.75rem;
  }
  .rstrip__title {
