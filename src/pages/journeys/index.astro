---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Enquiry from '../../components/Enquiry.astro';
import { journeys, site } from '../../data/site';

const title = `All Journeys — ${site.shortName}`;
const description = 'Every safari and itinerary we run, from short crater fly-ins to the full nine-day route through the north.';
const filters = ['All', ...Array.from(new Set(journeys.map((j) => j.category)))];
---

<Base title={title} description={description}>
  <Header />
  <main>
    <section class="jhero">
      <div class="jhero__content wrap">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/">Home</a><span>/</span><span class="crumbs__here">Journeys</span>
        </nav>
        <span class="eyebrow" style="color: var(--color-accent-soft)">All Journeys</span>
        <h1>Every route we run</h1>
        <p class="jhero__lead">From short crater fly-ins to the full nine-day route through the north — the complete library, not just the highlights.</p>
      </div>
    </section>

    <section class="journeys section wrap">
      <div class="journeys__tabs" role="tablist" aria-label="Journey categories">
        {filters.map((f, i) => (
          <button
            class:list={['tab', { 'tab--active': i === 0 }]}
            role="tab"
            aria-selected={i === 0}
            data-filter={f}
          >
            {f}
          </button>
        ))}
      </div>

      <div class="journeys__grid" data-journeys-grid>
        {journeys.map((j) => (
          <a class="jcard" href={`/journeys/${j.slug}`} data-category={j.category}>
            <div class="jcard__frame">
              <img src={j.image} alt={j.title} loading="lazy" />
              <span class="jcard__price">
                {j.priceFrom.startsWith('$') ? (
                  <>From {j.priceFrom} <span class="jcard__price-unit">/ person</span></>
                ) : (
                  j.priceFrom
                )}
              </span>
            </div>
            <span class="jcard__meta">{j.meta}</span>
            <h3 class="jcard__title">{j.title}</h3>
            <span class="jcard__cta">Explore</span>
          </a>
        ))}
      </div>
    </section>

    <Enquiry />
  </main>
  <Footer />
</Base>

<style>
  .jhero { background-color: var(--color-ink); color: var(--color-on-accent); }
  .jhero__content {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-block: clamp(3.5rem, 8vw, 6rem) clamp(2.5rem, 5vw, 4rem);
    max-width: 760px;
  }
  .crumbs {
    display: flex; align-items: center; gap: 0.6rem;
    font-family: var(--font-mono); font-size: 0.6875rem; letter-spacing: 0.16em; text-transform: uppercase;
    color: rgba(247, 244, 238, 0.7);
  }
  .crumbs a:hover { color: var(--color-on-accent); }
  .crumbs__here { color: var(--color-accent-soft); }
  .jhero h1 { font-size: clamp(2.75rem, 6vw, 4.5rem); font-weight: var(--fw-light); }
  .jhero__lead { color: rgba(247, 244, 238, 0.8); line-height: 1.6; font-size: 1.0625rem; }

  .journeys { background-color: var(--color-surface); }
  .journeys__tabs {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(1rem, 2.5vw, 2.375rem);
    padding-bottom: 3.375rem;
  }
  .tab {
    font-size: var(--text-label);
    font-weight: var(--fw-medium);
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--color-slate);
    padding-bottom: 0.5rem;
    border-bottom: 2px solid transparent;
    transition: color 0.2s ease, border-color 0.2s ease;
  }
  .tab:hover { color: var(--color-ink); }
  .tab--active {
    color: var(--color-ink);
    font-weight: var(--fw-semibold);
    border-bottom-color: var(--color-accent);
  }

  .journeys__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem 1.5rem;
    row-gap: 3rem;
  }
  .jcard {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    text-align: center;
  }
  .jcard__frame { position: relative; width: 100%; aspect-ratio: 5 / 6; overflow: hidden; margin-bottom: 1.125rem; }
  .jcard__frame img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s ease; }
  .jcard:hover .jcard__frame img { transform: scale(1.04); }
  .jcard__price {
    position: absolute;
    top: 1rem;
    left: 1rem;
    display: flex;
    align-items: baseline;
    gap: 0.3rem;
    padding: 0.4rem 0.75rem;
    background-color: var(--color-ink);
    color: var(--color-on-accent);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
  }
  .jcard__price-unit {
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(247, 244, 238, 0.7);
  }
  .jcard__meta {
    font-family: var(--font-mono); font-size: 0.6875rem; letter-spacing: 0.2em; text-transform: uppercase;
    color: var(--color-slate);
  }
  .jcard__title { font-size: clamp(1.375rem, 2.6vw, 1.75rem); color: var(--color-ink); }
  .jcard__cta {
    margin-top: 0.375rem;
    padding: 0.875rem 2.375rem;
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-full);
    font-size: 0.8125rem;
    font-weight: var(--fw-semibold);
    letter-spacing: 0.11em;
    text-transform: uppercase;
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }
  .jcard:hover .jcard__cta { border-color: var(--color-accent); color: var(--color-accent); }
  .jcard[hidden] { display: none; }

  @media (max-width: 860px) {
    .journeys__grid { grid-template-columns: 1fr; max-width: 460px; margin-inline: auto; gap: 3rem; }
  }
</style>

<script>
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.tab'));
  const cards = Array.from(document.querySelectorAll<HTMLElement>('.jcard'));

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      tabs.forEach((t) => {
        t.classList.toggle('tab--active', t === tab);
        t.setAttribute('aria-selected', String(t === tab));
      });
      const category = tab.dataset.filter ?? 'All';
      cards.forEach((card) => {
        card.hidden = category !== 'All' && card.dataset.category !== category;
      });
    });
  });
</script>
